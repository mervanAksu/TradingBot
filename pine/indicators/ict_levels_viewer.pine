//@version=6
// ICT Levels Viewer (phase 1) - draws the ict_core / ict_time detectors for eyeballing. SOURCE file: it imports the
// libraries. TradingView only imports PUBLISHED libraries and this project never publishes, so the script that is
// saved to TradingView is the bundled ict_levels_viewer.pine built by scripts/build_pine.py (libraries inlined).
// "P:" plots are data-window-only probe values latched on the date `Probe date` (used for MCP eyeball checks).
indicator("ICT Levels Viewer", "ICT Lv", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 300, max_bars_back = 500)
// ======== inlined from pine/lib/ict_core.pine (generated by scripts/build_pine.py; do not edit here)
type Zone
    float  top
    float  bottom
    float  ce
    float  q25
    float  q75
    int    dir
    int    t_created
    int    t_end
    bool   mitigated = false
    string kind      = ""
    int    state     = 0
    float  key
    float  ext_hi
    float  ext_lo
    int    quality   = 0
    bool   flag      = false
type Level
    float  price
    string kind
    int    t
    int    dir = 0
newZone(float top, float bottom, int dir, string kind, int t) =>
    float rng = top - bottom
    Zone.new(top, bottom, bottom + rng * 0.5, bottom + rng * 0.25, bottom + rng * 0.75, dir, t, na, false, kind)
overlaps(Zone a, Zone b) =>
    not na(a) and not na(b) and a.bottom <= b.top and b.bottom <= a.top
grid(float lo, float hi, int n = 4) =>
    array<float> lv = array.new<float>()
    for i = 0 to n
        lv.push(lo + (hi - lo) * i / n)
    lv
_dirOf(int off) => close[off] > open[off] ? 1 : close[off] < open[off] ? -1 : 0
swingHigh(int len = 1, bool useBody = false) =>
    bool ok = bar_index >= 2 * len
    if ok
        for i = 1 to len
            if not (high[len] > high[len + i] and high[len] >= high[len - i])
                ok := false
    float p = ok ? (useBody ? math.max(open[len], close[len]) : high[len]) : na
    [ok, p, ok ? time[len] : na, ok ? bar_index - len : na]
swingLow(int len = 1, bool useBody = false) =>
    bool ok = bar_index >= 2 * len
    if ok
        for i = 1 to len
            if not (low[len] < low[len + i] and low[len] <= low[len - i])
                ok := false
    float p = ok ? (useBody ? math.min(open[len], close[len]) : low[len]) : na
    [ok, p, ok ? time[len] : na, ok ? bar_index - len : na]
nest(bool isNew, float price, int t, bool isHigh) =>
    var float p1 = na
    var float p2 = na
    var int   t1 = na
    bool  hit = false
    float hp  = na
    int   ht  = na
    if isNew
        if not na(p1) and not na(p2)
            bool mid = isHigh ? (p1 > p2 and p1 > price) : (p1 < p2 and p1 < price)
            if mid
                hit := true
                hp  := p1
                ht  := t1
        p2 := p1
        p1 := price
        t1 := t
    [hit, hp, ht]
eqPool(bool isNew, float price, int t, bool isHigh, float tol, bool rightShorter = true, int maxSwings = 10) =>
    var array<float> ps = array.new<float>()
    var array<int>   ts = array.new<int>()
    var array<float> xc = array.new<float>()
    float s = isHigh ? 1.0 : -1.0
    if ps.size() > 0
        for i = ps.size() - 1 to 0
            if s * (isHigh ? high : low) > s * ps.get(i)
                ps.remove(i)
                ts.remove(i)
                xc.remove(i)
            else
                xc.set(i, isHigh ? math.max(xc.get(i), close) : math.min(xc.get(i), close))
    Zone z = na
    if isNew
        if ps.size() > 0
            for i = ps.size() - 1 to 0
                float a = ps.get(i)
                bool inTol = math.abs(a - price) <= tol
                bool order = not rightShorter or s * price <= s * a
                if inTol and order
                    float lvl = isHigh ? math.max(a, price) : math.min(a, price)
                    z := newZone(lvl, lvl, isHigh ? 1 : -1, isHigh ? "EQH" : "EQL", t)
                    z.key     := lvl
                    z.ext_hi  := math.max(a, price)
                    z.ext_lo  := math.min(a, price)
                    z.quality := s * price < s * a ? 1 : price == a ? 2 : 3
                    z.flag    := s * xc.get(i) <= s * lvl
                    z.t_created := ts.get(i)
                    break
        ps.push(price)
        ts.push(t)
        xc.push(close)
        if ps.size() > maxSwings
            ps.shift()
            ts.shift()
            xc.shift()
    z
displacementBar(float bodyAtr = 1.0, float closePos = 0.7, simple int atrLen = 14, float minBody = 0.0) =>
    float atr  = ta.atr(atrLen)
    float body = math.abs(close - open)
    float rng  = high - low
    int d = 0
    if rng > 0 and body >= bodyAtr * atr and body >= minBody
        if close > open and (close - low) / rng >= closePos
            d := 1
        else if close < open and (high - close) / rng >= closePos
            d := -1
    d
displacementLeg(bool fvgBull, bool fvgBear, float legAtr = 1.5, int maxBars = 3, simple int atrLen = 14) =>
    float atr = ta.atr(atrLen)
    int d0 = _dirOf(0)
    int res = 0
    if d0 != 0 and bar_index > maxBars
        float sumB = 0.0
        bool gap = false
        for i = 0 to maxBars - 1
            if _dirOf(i) != d0
                break
            sumB += math.abs(close[i] - open[i])
            gap := gap or (d0 == 1 ? fvgBull[i] : fvgBear[i])
            if sumB >= legAtr * atr and gap
                res := d0
                break
    res
volumeImbalance(float minSize) =>
    int p = close[1] == open[1] ? 2 : 1
    Zone z = na
    if bar_index > 2
        float bh0 = math.max(open, close)
        float bl0 = math.min(open, close)
        float bhp = math.max(open[p], close[p])
        float blp = math.min(open[p], close[p])
        if bl0 > bhp and low <= high[p] and bl0 - bhp >= minSize
            z := newZone(bl0, bhp, 1, "VI", time)
        else if bh0 < blp and high >= low[p] and blp - bh0 >= minSize
            z := newZone(blp, bh0, -1, "VI", time)
    z
viUpdate(Zone z) =>
    bool closed = false
    if not z.mitigated and time > z.t_created
        if math.min(open, close) <= z.bottom and math.max(open, close) >= z.top
            z.mitigated := true
            z.state := 3
            z.t_end := time
            closed := true
    closed
fvg(float minSize, bool withVI = true, bool c2Disp = false) =>
    Zone z = na
    if bar_index >= 2
        if low > high[2] and low - high[2] >= minSize
            float bot = high[2]
            float top = low
            if withVI
                float bh2 = math.max(open[2], close[2])
                float bl1 = math.min(open[1], close[1])
                if bl1 > bh2 and low[1] <= high[2] and bl1 >= bot and bh2 < bot
                    bot := bh2
                float bh1 = math.max(open[1], close[1])
                float bl0 = math.min(open, close)
                if bl0 > bh1 and high[1] >= low and bh1 <= top and bl0 > top
                    top := bl0
            z := newZone(top, bot, 1, "FVG", time[2])
        else if high < low[2] and low[2] - high >= minSize
            float top = low[2]
            float bot = high
            if withVI
                float bl2 = math.min(open[2], close[2])
                float bh1 = math.max(open[1], close[1])
                if bh1 < bl2 and high[1] >= low[2] and bh1 <= top and bl2 > top
                    top := bl2
                float bl1 = math.min(open[1], close[1])
                float bh0 = math.max(open, close)
                if bh0 < bl1 and low[1] <= high and bl1 >= bot and bh0 < bot
                    bot := bh0
            z := newZone(top, bot, -1, "FVG", time[2])
        if not na(z)
            z.flag := c2Disp
            z.ext_hi := z.dir == 1 ? na : high[2]
            z.ext_lo := z.dir == 1 ? low[2] : na
    z
fvgUpdate(Zone z) =>
    int ev = 0
    if not z.mitigated
        bool bull = z.dir == 1
        if z.state == 0 and (bull ? low <= z.top : high >= z.bottom)
            z.state := 1
        if z.state < 2 and (bull ? close < z.ce : close > z.ce)
            z.state := 2
        if bull ? close < z.bottom : close > z.top
            z.state := 3
            z.mitigated := true
            z.t_end := time
            ev := 1
    ev
ifvgFrom(Zone z) =>
    Zone n = newZone(z.top, z.bottom, -z.dir, "IFVG", time)
    n.key := z.dir == 1 ? z.bottom : z.top
    n
ifvgUpdate(Zone z) =>
    int ev = 0
    if not z.mitigated and time > z.t_created
        bool bear = z.dir == -1
        if z.state == 0 and (bear ? high >= z.bottom : low <= z.top)
            z.state := 1
        if bear ? close > z.top : close < z.bottom
            ev := 2
        else if bear ? close > z.ce : close < z.ce
            ev := 1
        if ev > 0
            z.state := 3
            z.mitigated := true
            z.t_end := time
    ev
orderBlock(int maxRun = 5) =>
    var Zone pBear = na
    var Zone pBull = na
    if bar_index > maxRun + 1
        for side = 0 to 1
            int d = side == 0 ? 1 : -1
            if _dirOf(0) == -d and _dirOf(1) == d
                int f = 1
                while f < maxRun and _dirOf(f + 1) != -d
                    f += 1
                while f > 1 and _dirOf(f) == 0
                    f -= 1
                float key = open[f]
                float bt = math.max(open[1], close[1])
                float bb = math.min(open[1], close[1])
                float hx = high[1]
                float lx = low[1]
                for j = 1 to f
                    bt := math.max(bt, open[j], close[j])
                    bb := math.min(bb, open[j], close[j])
                    hx := math.max(hx, high[j])
                    lx := math.min(lx, low[j])
                Zone z = d == 1 ? newZone(bt, key, -1, "OB", time[f]) : newZone(key, bb, 1, "OB", time[f])
                z.key := key
                z.ext_hi := hx
                z.ext_lo := lx
                if d == 1
                    pBear := z
                else
                    pBull := z
    Zone vBear = na
    Zone vBull = na
    if not na(pBear) and low < pBear.key
        vBear := pBear
        pBear := na
    if not na(pBull) and high > pBull.key
        vBull := pBull
        pBull := na
    [vBear, vBull]
blockUpdate(Zone z) =>
    bool failed = false
    if not z.mitigated
        bool bear = z.dir == -1
        if z.state == 0 and (bear ? high >= z.bottom : low <= z.top)
            z.state := 1
        if bear ? close > z.ce : close < z.ce
            z.state := 3
            z.mitigated := true
            z.t_end := time
            failed := true
    failed
_breakerSide(bool bear, bool newExt, float extP, int extI, bool newOpp, float oppP, int oppI, float sweepMin, bool closeMode, int maxRun, int maxBack) =>
    var array<float> oP = array.new<float>()
    var array<int>   oI = array.new<int>()
    var float prevExt  = na
    var int   prevExtI = na
    var float aL  = na
    var int   aLI = na
    var float aH1 = na
    var float aH2 = na
    float s = bear ? 1.0 : -1.0
    if newOpp
        oP.push(oppP)
        oI.push(oppI)
        if oP.size() > 50
            oP.shift()
            oI.shift()
    if newExt
        if not na(prevExt) and s * extP > s * prevExt + sweepMin
            float best = na
            int   bestI = na
            if oP.size() > 0
                for k = 0 to oP.size() - 1
                    int ii = oI.get(k)
                    if ii > prevExtI and ii < extI and (na(best) or s * oP.get(k) < s * best)
                        best  := oP.get(k)
                        bestI := ii
            if not na(best)
                aH1 := prevExt
                aL  := best
                aLI := bestI
                aH2 := extP
            else if not na(aH2) and s * extP > s * aH2
                aH2 := extP
        prevExt  := extP
        prevExtI := extI
    Zone z = na
    if not na(aL)
        float px = closeMode ? close : (bear ? low : high)
        if s * px < s * aL
            int o0 = bar_index - aLI
            int st = na
            if o0 + 5 <= maxBack
                for j = o0 to o0 + 5
                    if s * (close[j] - open[j]) < 0
                        st := j
                        break
            if not na(st)
                float bt = math.max(open[st], close[st])
                float bb = math.min(open[st], close[st])
                int j = st + 1
                int n = 1
                while n < maxRun and j <= maxBack and s * (close[j] - open[j]) < 0
                    bt := math.max(bt, open[j], close[j])
                    bb := math.min(bb, open[j], close[j])
                    j += 1
                    n += 1
                z := newZone(bt, bb, bear ? -1 : 1, "BRK", time[j - 1])
                z.key := aL
                z.ext_hi := bear ? aH2 : aH1
                z.ext_lo := bear ? aH1 : aH2
            aL  := na
            aLI := na
            aH1 := na
            aH2 := na
    z
breaker(bool isSH, float shP, int shI, bool isSL, float slP, int slI, float sweepMin = 0.0, bool closeMode = false, int maxRun = 5, int maxBack = 450) =>
    Zone b1 = _breakerSide(true, isSH, shP, shI, isSL, slP, slI, sweepMin, closeMode, maxRun, maxBack)
    Zone b2 = _breakerSide(false, isSL, slP, slI, isSH, shP, shI, sweepMin, closeMode, maxRun, maxBack)
    [b1, b2]
_cisdSide(bool bear, bool newPivot, int maxSeries, int maxBars, bool closeMode) =>
    var float lvl = na
    var int   armed = na
    var int   tS = na
    float s = bear ? 1.0 : -1.0
    bool  fired = false
    float fL = na
    int   fT = na
    if newPivot and bar_index > maxSeries + 3
        int e = na
        if s * (close[1] - open[1]) > 0
            e := s * (close - open) > 0 ? 0 : 1
        else if s * (close[2] - open[2]) > 0
            e := 2
        if not na(e)
            int f = e
            int n = 1
            while n < maxSeries and s * (close[f + 1] - open[f + 1]) >= 0
                f += 1
                n += 1
            while f > e and close[f] == open[f]
                f -= 1
            lvl   := open[f]
            armed := bar_index
            tS    := time[f]
    if not na(lvl)
        if bar_index - armed > maxBars
            lvl := na
        else
            float px = closeMode ? close : (bear ? low : high)
            if s * px < s * lvl
                fired := true
                fL := lvl
                fT := tS
                lvl := na
    [fired, fL, fT]
cisd(bool isSH, bool isSL, int maxSeries = 10, int maxBars = 30, bool closeMode = false) =>
    [f1, l1, t1] = _cisdSide(true, isSH, maxSeries, maxBars, closeMode)
    [f2, l2, t2] = _cisdSide(false, isSL, maxSeries, maxBars, closeMode)
    [f1, l1, t1, f2, l2, t2]
_mssSide(bool bear, bool newPool, float poolP, bool newRef, float refP, bool extRaid, int dispDir, int maxBars, bool closeMode, bool needDisp) =>
    var float pool = na
    var float lastRef = na
    var float ref = na
    var int   r = na
    var bool  disp = false
    float s = bear ? 1.0 : -1.0
    int want = bear ? -1 : 1
    bool  fired = false
    float fRef = na
    if not na(ref)
        if bar_index - r > maxBars
            ref := na
        else
            disp := disp or dispDir == want
            float px = closeMode ? close : (bear ? low : high)
            if s * px < s * ref and (disp or not needDisp)
                fired := true
                fRef := ref
                ref := na
    bool raid = (not na(pool) and s * (bear ? high : low) > s * pool) or extRaid
    if raid and not na(lastRef)
        r := bar_index
        ref := lastRef
        disp := dispDir == want
        pool := na
    if newPool
        pool := poolP
    if newRef
        lastRef := refP
    [fired, fRef]
mss(bool isSH, float shP, bool isSL, float slP, int dispDir, bool extRaidUp = false, bool extRaidDn = false, int maxBars = 20, bool closeMode = false, bool needDisp = true) =>
    [f1, r1] = _mssSide(true, isSH, shP, isSL, slP, extRaidUp, dispDir, maxBars, closeMode, needDisp)
    [f2, r2] = _mssSide(false, isSL, slP, isSH, shP, extRaidDn, dispDir, maxBars, closeMode, needDisp)
    [f1, r1, f2, r2]
wickZone(bool upper, int off = 0, float minAtr = 0.5, bool force = false, simple int atrLen = 14) =>
    float atr = ta.atr(atrLen)
    float bh = math.max(open[off], close[off])
    float bl = math.min(open[off], close[off])
    float len = upper ? high[off] - bh : bl - low[off]
    Zone z = na
    if len > 0 and (force or len >= minAtr * atr[off])
        z := upper ? newZone(high[off], bh, -1, "WICK", time[off]) : newZone(bl, low[off], 1, "WICK", time[off])
    z
wickUpdate(Zone z) =>
    bool failed = false
    if not z.mitigated and time > z.t_created
        if z.dir == -1 ? close > z.ce : close < z.ce
            z.mitigated := true
            z.state := 3
            z.t_end := time
            failed := true
    failed
// ======== inlined from pine/lib/ict_time.pine (generated by scripts/build_pine.py; do not edit here)
const string TZ = "America/New_York"
nyMin(int t) =>
    hour(t, TZ) * 60 + minute(t, TZ)
nyDate(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
startsAt(int hh, int mm) =>
    nyMin(time) == hh * 60 + mm
openAt(int hh, int mm) =>
    var float op = na
    bool hit = startsAt(hh, mm)
    if hit
        op := open
    [op, hit]
inWindow(simple string sess) =>
    not na(time(timeframe.period, sess, TZ))
sessionRange(simple string sess) =>
    var float hi = na
    var float lo = na
    var float op = na
    bool inS = not na(time(timeframe.period, sess, TZ))
    bool prev = inS[1]
    bool started = inS and not prev
    bool ended = not inS and prev
    if started
        hi := high
        lo := low
        op := open
    else if inS
        hi := math.max(hi, high)
        lo := math.min(lo, low)
    [hi, lo, op, inS, started, ended]
prevDayHL() =>
    var float curH = na
    var float curL = na
    var float pdh = na
    var float pdl = na
    bool nd = timeframe.change("D")
    if nd
        pdh := curH
        pdl := curL
        curH := high
        curL := low
    else
        curH := na(curH) ? high : math.max(curH, high)
        curL := na(curL) ? low : math.min(curL, low)
    [pdh, pdl, nd]
macro(int padMin = 0) =>
    int m = minute(time, TZ)
    int t = nyMin(time)
    bool hourly = m >= 50 - padMin or m < 10 + padMin
    bool extra = t >= 15 * 60 + 15 and t < 16 * 60
    [hourly, extra]
openingGap(float quarterMin) =>
    int kind = 0
    float top = na
    float bot = na
    if startsAt(18, 0) and bar_index > 0 and time_close[1] < time
        int dow = dayofweek(time, TZ)
        kind := dow == dayofweek.sunday ? 2 : (dow >= dayofweek.monday and dow <= dayofweek.thursday) ? 1 : 0
        if kind > 0
            top := math.max(close[1], open)
            bot := math.min(close[1], open)
    float rng = top - bot
    bool quarters = kind > 0 and rng >= quarterMin
    [kind, top, bot, kind > 0 ? (top + bot) / 2 : na, quarters ? bot + rng * 0.25 : na, quarters ? bot + rng * 0.75 : na]
org(float minSize = 20.0, float bandMid = 75.0, float bandHigh = 120.0) =>
    var float settle = na
    bool isNew = false
    float top = na
    float bot = na
    int dir = 0
    int band = 0
    if timeframe.isintraday and nyMin(time_close) == 16 * 60 + 15
        settle := close
    if startsAt(9, 30) and not na(settle)
        isNew := true
        top := math.max(settle, open)
        bot := math.min(settle, open)
        dir := open > settle ? -1 : open < settle ? 1 : 0
        float sz = top - bot
        band := sz < minSize ? 0 : sz < bandMid ? 1 : sz < bandHigh ? 2 : 3
    [isNew, top, bot, dir, band, settle, isNew ? open : na]
orgCeTouch(float ce) =>
    int t = nyMin(time)
    t >= 9 * 60 + 30 and t < 10 * 60 and low <= ce and high >= ce
// ======== end of inlined libraries


// ---------------------------------------------------------------- inputs
GL = "Levels"
GC = "Context"
GT = "Time"
GP = "Probe"
float TICK  = syminfo.mintick
bool  isES  = syminfo.root == "ES" or syminfo.root == "MES"
float scale = isES ? 0.25 : 1.0     // NQ-to-ES size scaling (key-levels conventions)
float tickS = isES ? 0.5 : 1.0      // tick defaults NQ 4 / ES 2

iSwing   = input.bool(true, "Swing points (3-bar)", group = GL)
iSwBody  = input.bool(false, "Swing price = body extreme", group = GL)
iEq      = input.bool(true, "Relative equal H/L", group = GL)
iEqTol   = input.int(4, "EQ tolerance ticks (NQ; ES x0.5)", 0, 12, group = GL)
iFvg     = input.bool(true, "FVG", group = GL)
iFvgMin  = input.int(4, "FVG min ticks (NQ; ES x0.5)", 1, 40, group = GL)
iFvgVI   = input.bool(true, "FVG box incl. adjacent VI", group = GL)
iIfvg    = input.bool(true, "IFVG", group = GL)
iVi      = input.bool(false, "Volume imbalance", group = GL)
iViMin   = input.int(1, "VI min ticks", 1, 8, group = GL)
iOb      = input.bool(true, "Order blocks", group = GL)
iObRun   = input.int(5, "OB / breaker max run", 1, 10, group = GL)
iBrk     = input.bool(true, "Breakers (U = unicorn)", group = GL)
iBrkCl   = input.bool(false, "Breaker trigger = body close", group = GL)
iCisd    = input.bool(true, "CISD", group = GL)
iCisdCl  = input.bool(false, "CISD trigger = body close", group = GL)
iCisdMax = input.int(30, "CISD max bars", 5, 120, group = GL)
iMss     = input.bool(true, "MSS", group = GL)
iMssCl   = input.bool(false, "MSS trigger = body close", group = GL)
iMssDisp = input.bool(true, "MSS needs displacement", group = GL)
iMssMax  = input.int(20, "MSS max bars", 5, 60, group = GL)
iWick    = input.bool(false, "Wick CE (prominent wicks)", group = GL)
iWickAtr = input.float(0.5, "Wick min x ATR", 0.2, 1.5, group = GL)
iDisp    = input.bool(false, "Mark displacement bars", group = GC)
iDBody   = input.float(1.0, "Displacement body x ATR", 0.6, 2.0, group = GC)
iDPos    = input.float(0.7, "Displacement close position", 0.5, 0.9, group = GC)
iMaxZ    = input.int(20, "Max zones kept per type", 5, 100, group = GC)
iGaps    = input.bool(true, "NDOG / NWOG", group = GT)
iGapKeep = input.int(5, "Opening gaps kept", 1, 12, group = GT)
iOrg     = input.bool(true, "Opening range gap (16:14 -> 09:30) + quadrants", group = GT)
iOrgMin  = input.float(20, "ORG min handles (NQ; ES x0.25)", group = GT)
iOrgMid  = input.float(75, "ORG band edge 1", group = GT)
iOrgHigh = input.float(120, "ORG band edge 2", group = GT)
iOrgKeep = input.int(5, "ORGs kept", 1, 5, group = GT)
iAsia    = input.bool(true, "Asia range", group = GT)
sAsia    = input.session("1800-0000", "Asia window", group = GT)
iLon     = input.bool(true, "London killzone", group = GT)
sLon     = input.session("0200-0500", "London window", group = GT)
iNy      = input.bool(true, "NY AM killzone", group = GT)
sNy      = input.session("0700-1000", "NY AM window", group = GT)
iLunch   = input.bool(false, "Lunch", group = GT)
sLunch   = input.session("1130-1330", "Lunch window", group = GT)
iPm      = input.bool(false, "NY PM", group = GT)
sPm      = input.session("1330-1600", "NY PM window", group = GT)
iPd      = input.bool(true, "Previous day H/L", group = GT)
iOpens   = input.bool(true, "Opens 00:00 / 08:30 / 09:30", group = GT)
iMacro   = input.bool(true, "Macro background (xx:50-xx:10, 15:15-16:00)", group = GT)
iProbe   = input.int(20260708, "Probe date yyyymmdd (NY)", group = GP)

// ---------------------------------------------------------------- drawing helpers
addZone(array<Zone> zs, array<box> bs, Zone z, color c, int maxN, string txt) =>
    box b = box.new(z.t_created, z.top, time, z.bottom, xloc = xloc.bar_time, bgcolor = c, border_color = color.new(c, 40), text = txt, text_size = size.tiny, text_halign = text.align_left, text_color = color.gray)
    zs.push(z)
    bs.push(b)
    if zs.size() > maxN
        zs.shift()
        box.delete(bs.shift())

extendZones(array<Zone> zs, array<box> bs) =>
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            Zone z = zs.get(i)
            box b = bs.get(i)
            if not z.mitigated
                b.set_right(time)
            else if not na(z.t_end)
                b.set_right(z.t_end)
                b.set_bgcolor(color.new(color.gray, 90))

addLine(array<line> ls, int t1, float p, color c, string txt, int maxN) =>
    line l = line.new(t1, p, time, p, xloc = xloc.bar_time, color = c, width = 1)
    label.new(time, p, txt, xloc = xloc.bar_time, style = label.style_none, textcolor = c, size = size.tiny)
    ls.push(l)
    if ls.size() > maxN
        line.delete(ls.shift())

// ---------------------------------------------------------------- detectors (called every bar)
[sh, shP, shT, shI] = swingHigh(1, iSwBody)
[sl, slP, slT, slI] = swingLow(1, iSwBody)
int dBar = displacementBar(iDBody, iDPos, 14)
Zone fz = fvg(iFvgMin * tickS * TICK, iFvgVI, dBar[1] != 0)
bool fB = not na(fz) and fz.dir == 1
bool fS = not na(fz) and fz.dir == -1
[obBear, obBull] = orderBlock(iObRun)
[brBear, brBull] = breaker(sh, shP, shI, sl, slP, slI, 0.0, iBrkCl, iObRun, 450)
[cBf, cBl, cBt, cUf, cUl, cUt] = cisd(sh, sl, 10, iCisdMax, iCisdCl)
[mBf, mBr, mUf, mUr] = mss(sh, shP, sl, slP, dBar, false, false, iMssMax, iMssCl, iMssDisp)
float eqTol = iEqTol * tickS * TICK
Zone eqH = eqPool(sh, shP, shT, true, eqTol, true, 10)
Zone eqL = eqPool(sl, slP, slT, false, eqTol, true, 10)
Zone vz = volumeImbalance(iViMin * TICK)
Zone wU = wickZone(true, 0, iWickAtr)
Zone wL = wickZone(false, 0, iWickAtr)

[gk, gTop, gBot, gCe, gQ25, gQ75] = openingGap(80 * TICK * scale)
[orgNew, oTop, oBot, oDir, oBand, oSettle, oOpen] = org(iOrgMin * scale, iOrgMid * scale, iOrgHigh * scale)
[aH, aL, aO, aIn, aSt, aEn] = sessionRange(sAsia)
[lH, lL, lO, lIn, lSt, lEn] = sessionRange(sLon)
[nH, nL, nO, nIn, nSt, nEn] = sessionRange(sNy)
[uH, uL, uO, uIn, uSt, uEn] = sessionRange(sLunch)
[pH, pL, pO, pIn, pSt, pEn] = sessionRange(sPm)
[pdh, pdl, newDay] = prevDayHL()
[o00, o00New] = openAt(0, 0)
[o830, o830New] = openAt(8, 30)
[o930, o930New] = openAt(9, 30)
[inMac, inMacX] = macro(0)

// ---------------------------------------------------------------- zone bookkeeping + drawing
var array<Zone> fvgs = array.new<Zone>()
var array<box>       fvgB = array.new<box>()
var array<Zone> ifvs = array.new<Zone>()
var array<box>       ifvB = array.new<box>()
var array<Zone> vis  = array.new<Zone>()
var array<box>       viB  = array.new<box>()
var array<Zone> obs  = array.new<Zone>()
var array<box>       obB  = array.new<box>()
var array<Zone> brks = array.new<Zone>()
var array<box>       brB  = array.new<box>()
var array<Zone> wks  = array.new<Zone>()
var array<box>       wkB  = array.new<box>()
var array<Zone> eqs  = array.new<Zone>()
var array<box>       eqB  = array.new<box>()
var array<Zone> gaps = array.new<Zone>()
var array<box>       gapB = array.new<box>()
var array<line>      evL  = array.new<line>()
var array<line>      orgL = array.new<line>()
int nIfvgNew = 0

// updates first (zones created on this bar are added afterwards)
if fvgs.size() > 0
    for i = 0 to fvgs.size() - 1
        Zone z = fvgs.get(i)
        if fvgUpdate(z) == 1 and iIfvg
            Zone iz = ifvgFrom(z)
            addZone(ifvs, ifvB, iz, color.new(iz.dir == 1 ? color.teal : color.maroon, 75), iMaxZ, "IFVG")
            nIfvgNew += 1
if ifvs.size() > 0
    for z in ifvs
        ifvgUpdate(z)
if vis.size() > 0
    for z in vis
        viUpdate(z)
if obs.size() > 0
    for z in obs
        blockUpdate(z)
if brks.size() > 0
    for z in brks
        blockUpdate(z)
if wks.size() > 0
    for z in wks
        wickUpdate(z)
if eqs.size() > 0
    for z in eqs
        if not z.mitigated and (z.dir == 1 ? high > z.key : low < z.key)
            z.mitigated := true
            z.t_end := time

if iFvg and not na(fz)
    addZone(fvgs, fvgB, fz, color.new(fz.dir == 1 ? color.green : color.red, 80), iMaxZ, fz.dir == 1 ? "BISI" : "SIBI")
if iVi and not na(vz)
    addZone(vis, viB, vz, color.new(color.yellow, 80), iMaxZ, "VI")
if iOb and not na(obBear)
    addZone(obs, obB, obBear, color.new(color.orange, 75), iMaxZ, "-OB")
if iOb and not na(obBull)
    addZone(obs, obB, obBull, color.new(color.blue, 75), iMaxZ, "+OB")
bool uniBear = false
bool uniBull = false
if fvgs.size() > 0
    for z in fvgs
        if not z.mitigated
            uniBear := uniBear or (z.dir == -1 and overlaps(brBear, z))
            uniBull := uniBull or (z.dir == 1 and overlaps(brBull, z))
if iBrk and not na(brBear)
    addZone(brks, brB, brBear, color.new(color.fuchsia, 75), iMaxZ, uniBear ? "-BRK U" : "-BRK")
if iBrk and not na(brBull)
    addZone(brks, brB, brBull, color.new(color.aqua, 75), iMaxZ, uniBull ? "+BRK U" : "+BRK")
if iWick and not na(wU)
    addZone(wks, wkB, wU, color.new(color.silver, 80), iMaxZ, "wick")
if iWick and not na(wL)
    addZone(wks, wkB, wL, color.new(color.silver, 80), iMaxZ, "wick")
if iEq and not na(eqH)
    addZone(eqs, eqB, eqH, color.new(color.red, 0), iMaxZ, eqH.flag ? "EQH smooth" : "EQH")
if iEq and not na(eqL)
    addZone(eqs, eqB, eqL, color.new(color.green, 0), iMaxZ, eqL.flag ? "EQL smooth" : "EQL")
if iGaps and gk > 0
    Zone g = newZone(gTop, gBot, 0, gk == 2 ? "NWOG" : "NDOG", time)
    addZone(gaps, gapB, g, color.new(gk == 2 ? color.purple : color.gray, 80), iGapKeep, g.kind + " CE " + str.tostring(gCe, format.mintick))
if iCisd and cBf
    addLine(evL, cBt, cBl, color.red, "CISD-", iMaxZ)
if iCisd and cUf
    addLine(evL, cUt, cUl, color.green, "CISD+", iMaxZ)
if iMss and mBf
    addLine(evL, time[1], mBr, color.maroon, "MSS-", iMaxZ)
if iMss and mUf
    addLine(evL, time[1], mUr, color.teal, "MSS+", iMaxZ)
if iOrg and orgNew
    int tEnd = time + 390 * 60000
    color oc = oDir == -1 ? color.red : color.green
    array<float> lv = grid(oBot, oTop, 4)
    for k = 0 to 4
        orgL.push(line.new(time, lv.get(k), tEnd, lv.get(k), xloc = xloc.bar_time, color = color.new(oc, k == 2 ? 0 : 50), style = k == 2 ? line.style_solid : line.style_dotted))
    label.new(time, oTop, "ORG " + (oDir == -1 ? "prem" : "disc") + " band " + str.tostring(oBand), xloc = xloc.bar_time, style = label.style_none, textcolor = oc, size = size.tiny)
    while orgL.size() > 5 * iOrgKeep
        line.delete(orgL.shift())

extendZones(fvgs, fvgB)
extendZones(ifvs, ifvB)
extendZones(vis, viB)
extendZones(obs, obB)
extendZones(brks, brB)
extendZones(wks, wkB)
extendZones(eqs, eqB)
extendZones(gaps, gapB)

plotshape(iSwing and sh, "STH", shape.triangledown, location.abovebar, color.red, offset = -1, size = size.tiny)
plotshape(iSwing and sl, "STL", shape.triangleup, location.belowbar, color.green, offset = -1, size = size.tiny)
plotshape(iDisp and dBar != 0, "Disp", shape.circle, location.bottom, dBar == 1 ? color.green : color.red, size = size.tiny)
plot(iAsia ? aH : na, "Asia H", color.new(color.orange, 30), style = plot.style_linebr)
plot(iAsia ? aL : na, "Asia L", color.new(color.orange, 30), style = plot.style_linebr)
plot(iLon ? lH : na, "London H", color.new(color.blue, 30), style = plot.style_linebr)
plot(iLon ? lL : na, "London L", color.new(color.blue, 30), style = plot.style_linebr)
plot(iNy ? nH : na, "NY AM H", color.new(color.purple, 30), style = plot.style_linebr)
plot(iNy ? nL : na, "NY AM L", color.new(color.purple, 30), style = plot.style_linebr)
plot(iLunch ? uH : na, "Lunch H", color.new(color.gray, 30), style = plot.style_linebr)
plot(iLunch ? uL : na, "Lunch L", color.new(color.gray, 30), style = plot.style_linebr)
plot(iPm ? pH : na, "PM H", color.new(color.olive, 30), style = plot.style_linebr)
plot(iPm ? pL : na, "PM L", color.new(color.olive, 30), style = plot.style_linebr)
plot(iPd ? pdh : na, "PDH", color.new(color.red, 0), style = plot.style_stepline)
plot(iPd ? pdl : na, "PDL", color.new(color.green, 0), style = plot.style_stepline)
plot(iOpens ? o00 : na, "Midnight open", color.new(color.black, 0), style = plot.style_stepline)
plot(iOpens ? o830 : na, "08:30 open", color.new(color.gray, 0), style = plot.style_stepline)
plot(iOpens ? o930 : na, "09:30 open", color.new(color.navy, 0), style = plot.style_stepline)
bgcolor(iMacro and (inMac or inMacX) and timeframe.isintraday and timeframe.multiplier <= 15 ? color.new(color.purple, 93) : na, title = "Macro")

// ---------------------------------------------------------------- probe (data window only)
DW = display.data_window
bool pd = nyDate(time) == iProbe
bool pdFirst = pd and not pd[1]
bool rth = nyMin(time) >= 570
var float lastGapTop = na
var float lastGapBot = na
var int   lastGapKind = 0
if gk > 0
    lastGapTop := gTop
    lastGapBot := gBot
    lastGapKind := gk
var float pMid = na
var float p830 = na
var float p930 = na
var float pOrgSet = na
var float pOrgOpen = na
var float pOrgBand = na
var float pGapTop = na
var float pGapBot = na
var float pGapKind = na
var float pAsiaH = na
var float pAsiaL = na
var float pLonH = na
var float pLonL = na
var float pPdh = na
var float pPdl = na
var float nFvgB = 0
var float nFvgS = 0
var float nIfvg = 0
var float nObS = 0
var float nObB = 0
var float nBrk = 0
var float nCisd = 0
var float nMss = 0
var float nEq = 0
var float nSw = 0
var float fFvgTop = na
var float fFvgBot = na
var float fFvgDir = na
var float fFvgT = na
var float fCisdLvl = na
var float fCisdDir = na
var float fCisdT = na
var float fMssRef = na
var float fMssDir = na
var float fMssT = na
var float fObKey = na
var float fObDir = na
var float fObT = na
if pd
    if o00New
        pMid := o00
    if o830New
        p830 := o830
    if o930New
        p930 := o930
    if orgNew
        pOrgSet := oSettle
        pOrgOpen := oOpen
        pOrgBand := oBand
    if pdFirst
        pGapTop := lastGapTop
        pGapBot := lastGapBot
        pGapKind := lastGapKind
        pPdh := pdh
        pPdl := pdl
    if aEn
        pAsiaH := aH
        pAsiaL := aL
    if lEn
        pLonH := lH
        pLonL := lL
    nFvgB += fB ? 1 : 0
    nFvgS += fS ? 1 : 0
    nIfvg += nIfvgNew
    nObS += na(obBear) ? 0 : 1
    nObB += na(obBull) ? 0 : 1
    nBrk += (na(brBear) ? 0 : 1) + (na(brBull) ? 0 : 1)
    nCisd += (cBf ? 1 : 0) + (cUf ? 1 : 0)
    nMss += (mBf ? 1 : 0) + (mUf ? 1 : 0)
    nEq += (na(eqH) ? 0 : 1) + (na(eqL) ? 0 : 1)
    nSw += (sh ? 1 : 0) + (sl ? 1 : 0)
    if rth
        if na(fFvgT) and not na(fz)
            fFvgTop := fz.top
            fFvgBot := fz.bottom
            fFvgDir := fz.dir
            fFvgT := nyMin(time)
        if na(fCisdT) and (cBf or cUf)
            fCisdLvl := cBf ? cBl : cUl
            fCisdDir := cBf ? -1 : 1
            fCisdT := nyMin(time)
        if na(fMssT) and (mBf or mUf)
            fMssRef := mBf ? mBr : mUr
            fMssDir := mBf ? -1 : 1
            fMssT := nyMin(time)
        if na(fObT) and (not na(obBear) or not na(obBull))
            fObKey := not na(obBear) ? obBear.key : obBull.key
            fObDir := not na(obBear) ? -1 : 1
            fObT := nyMin(time)
plot(pMid, "P:midnight open", display = DW)
plot(p830, "P:0830 open", display = DW)
plot(p930, "P:0930 open", display = DW)
plot(pOrgSet, "P:ORG settle", display = DW)
plot(pOrgOpen, "P:ORG open", display = DW)
plot(pOrgBand, "P:ORG band", display = DW)
plot(pGapKind, "P:gap kind", display = DW)
plot(pGapTop, "P:gap top", display = DW)
plot(pGapBot, "P:gap bottom", display = DW)
plot(pPdh, "P:PDH", display = DW)
plot(pPdl, "P:PDL", display = DW)
plot(pAsiaH, "P:Asia H", display = DW)
plot(pAsiaL, "P:Asia L", display = DW)
plot(pLonH, "P:London H", display = DW)
plot(pLonL, "P:London L", display = DW)
plot(nFvgB, "P:n BISI", display = DW)
plot(nFvgS, "P:n SIBI", display = DW)
plot(nIfvg, "P:n IFVG", display = DW)
plot(nObS, "P:n bear OB", display = DW)
plot(nObB, "P:n bull OB", display = DW)
plot(nBrk, "P:n breaker", display = DW)
plot(nCisd, "P:n CISD", display = DW)
plot(nMss, "P:n MSS", display = DW)
plot(nEq, "P:n EQ pools", display = DW)
plot(nSw, "P:n swings", display = DW)
plot(fFvgTop, "P:1st RTH FVG top", display = DW)
plot(fFvgBot, "P:1st RTH FVG bottom", display = DW)
plot(fFvgDir, "P:1st RTH FVG dir", display = DW)
plot(fFvgT, "P:1st RTH FVG min", display = DW)
plot(fCisdLvl, "P:1st RTH CISD level", display = DW)
plot(fCisdDir, "P:1st RTH CISD dir", display = DW)
plot(fCisdT, "P:1st RTH CISD min", display = DW)
plot(fMssRef, "P:1st RTH MSS ref", display = DW)
plot(fMssDir, "P:1st RTH MSS dir", display = DW)
plot(fMssT, "P:1st RTH MSS min", display = DW)
plot(fObKey, "P:1st RTH OB key", display = DW)
plot(fObDir, "P:1st RTH OB dir", display = DW)
plot(fObT, "P:1st RTH OB min", display = DW)
